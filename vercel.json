{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.yourbestseo.com" }],
      "destination": "https://yourbestseo.com/:path*",
      "statusCode": 301
    },
    { "source": "/blog", "destination": "/", "statusCode": 301 },
    { "source": "/blog/:path*", "destination": "/", "statusCode": 301 }
  ]
}
